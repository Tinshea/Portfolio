# Optional: a GitHub personal access token (no scopes needed for public data)
# used server-side only (src/app/api/pinned-repos/route.ts) to query the
# GraphQL API for pinned repositories. Never prefix this with NEXT_PUBLIC_ —
# doing so would ship it to the browser. Without it, the route falls back to
# the public, unauthenticated GitHub REST API.
GITHUB_TOKEN=
